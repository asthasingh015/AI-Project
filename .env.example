# Cortex AI Publisher -- copy to `.env` and fill in values.
# NEVER commit the real `.env` file.

APP_NAME=Cortex AI Publisher
APP_VERSION=1.0.0
ENVIRONMENT=development

DATABASE_URL=sqlite+aiosqlite:///./data/cortex_publisher.db

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

MEMBER1_PERSONA_URL=http://localhost:8002/api/persona
MEMBER2_TOPICS_URL=http://localhost:8001/api/topics/approved

SCHEDULER_ENABLED=true
SCHEDULER_INTERVAL_MINUTES=30

QUEUE_BATCH_SIZE=5
PUBLICATION_BATCH_SIZE=1
PUBLISH_MAX_ATTEMPTS=3
RETRY_BACKOFF_SECONDS=60

REQUEST_TIMEOUT_SECONDS=15

LOG_LEVEL=INFO
LOG_FILE=logs/publisher.log
